# Server & Environment
PORT=3000
NODE_ENV=development

# Database & Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/revenue_guardian
REDIS_URL=redis://localhost:6379

# PayPal Sandbox Credentials (Sandbox host only!)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_BUSINESS_EMAIL=merchant@example.com
PAYPAL_WEBHOOK_ID=your_registered_webhook_id
PAYPAL_WEBHOOK_TOLERANCE_SECONDS=300

# Sandbox Negative Testing Control
SANDBOX_NEGATIVE_TESTING=false

# LLM Providers & Quotas (OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_FALLBACKS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_PROVIDER_DAILY_CAP=100
LLM_DAILY_BUDGET=100

# Single-Owner Auth (better-auth)
BETTER_AUTH_SECRET=your_long_random_auth_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000
OWNER_EMAIL=owner@revenueguardian.local
OWNER_PASSWORD=OwnerSecurePass123!

